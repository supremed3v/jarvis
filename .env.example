# JARVIS Development Environment Variables
# Copy this file to .env and adjust values for local development.

# Local AI runtime (ADR-0004: Ollama, local-only, no API dependency)
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434

# Optional: NVIDIA cloud API for hybrid local+cloud LLM setups.
# Not wired to any code yet — reserved for SPEC-0026 (LLM Provider
# Interface) / SPEC-0029 (Model Router). Leave blank to stay fully
# local per ADR-0004; Ollama remains the only active runtime today.
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# Core runtime logging
LOG_LEVEL=debug

# Runtime environment marker
JARVIS_ENV=development
